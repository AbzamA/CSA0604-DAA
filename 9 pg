#include <stdio.h>

int main() {
    int arr[] = {-9, 3, 4, 6, 8, 9, 10, 30};
    int n = 8;
    int key = 10;

    int low = 0;
    int high = n - 1;
    int found = -1;

    while (low <= high) {

        int mid = (low + high) / 2;

        if (arr[mid] == key) {
            found = mid;
            break;
        }
        else if (arr[mid] < key) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    if (found != -1)
        printf("Element %d is found at position %d", key, found);
    else
        printf("Element %d is not found", key);

    return 0;
}
