#include <stdio.h>
#include <string.h>

int isPalindrome(char str[]) {
    int i = 0;
    int j = strlen(str) - 1;

    while (i < j) {
        if (str[i] != str[j])
            return 0;

        i++;
        j--;
    }

    return 1;
}

int main() {
    char words[5][20] = {"abc", "car", "ada", "racecar", "cool"};

    for (int i = 0; i < 5; i++) {
        if (isPalindrome(words[i])) {
            printf("%s", words[i]);
            return 0;
        }
    }

    printf("");

    return 0;
}
